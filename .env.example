# Copy this file to .env and edit the values you use.

# LLM options: groq or ollama
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
LLM_MAX_TOKENS=1000
# Seconds before an LLM request times out; must be positive
LLM_TIMEOUT=60

# Embedding options: sentence-transformers or ollama
EMBEDDING_PROVIDER=sentence-transformers
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=8

# Vector database settings
CHROMA_PERSIST_DIR=vector_db
TOP_K=8
# Legacy alias, still honoured when TOP_K is unset: RETRIEVAL_K
# Legacy aliases, still honoured when the primary name is unset:
# EMBEDDING_MODEL for SENTENCE_TRANSFORMER_MODEL, OLLAMA_MODEL for
# OLLAMA_LLM_MODEL, OLLAMA_EMBEDDING_MODEL for OLLAMA_EMBED_MODEL.

# PDF and chunking settings
MAX_PDF_MB=25
CHUNK_SIZE=900
CHUNK_OVERLAP=180
